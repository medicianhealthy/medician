<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/empty_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:id="@+id/empty_state_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="32dp"
        android:paddingBottom="48dp">

        <!-- Mascot Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mascot_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Mascot Glow Background -->
            <View
                android:id="@+id/mascot_glow"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:alpha="0.15"
                android:background="@drawable/ic_wizard_background"
                app:layout_constraintBottom_toBottomOf="@+id/empty_mascot"
                app:layout_constraintLeft_toLeftOf="@+id/empty_mascot"
                app:layout_constraintRight_toRightOf="@+id/empty_mascot"
                app:layout_constraintTop_toTopOf="@+id/empty_mascot"
                android:scaleX="1.6"
                android:scaleY="1.6" />

            <!-- High Def Mascot -->
            <ImageView
                android:id="@+id/empty_mascot"
                android:layout_width="@dimen/empty_state_mascot_size"
                android:layout_height="@dimen/empty_state_mascot_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_wizard_high_def"
                android:contentDescription="@null" />

            <!-- Animated Sparkles -->
            <ImageView
                android:id="@+id/empty_sparkle_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sparkle"
                app:layout_constraintBottom_toTopOf="@+id/empty_mascot"
                app:layout_constraintHorizontal_bias="0.2"
                app:layout_constraintLeft_toLeftOf="@+id/empty_mascot"
                app:layout_constraintRight_toRightOf="@+id/empty_mascot"
                app:layout_constraintTop_toTopOf="@+id/empty_mascot"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/empty_sparkle_2"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_sparkle"
                app:layout_constraintBottom_toBottomOf="@+id/empty_mascot"
                app:layout_constraintHorizontal_bias="0.85"
                app:layout_constraintLeft_toLeftOf="@+id/empty_mascot"
                app:layout_constraintRight_toRightOf="@+id/empty_mascot"
                app:layout_constraintTop_toBottomOf="@+id/empty_mascot"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/empty_sparkle_3"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sparkle"
                app:layout_constraintBottom_toBottomOf="@+id/empty_mascot"
                app:layout_constraintHorizontal_bias="0.95"
                app:layout_constraintLeft_toLeftOf="@+id/empty_mascot"
                app:layout_constraintRight_toRightOf="@+id/empty_mascot"
                app:layout_constraintTop_toTopOf="@+id/empty_mascot"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/empty_sparkle_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sparkle"
                app:layout_constraintBottom_toBottomOf="@+id/empty_mascot"
                app:layout_constraintHorizontal_bias="0.1"
                app:layout_constraintLeft_toLeftOf="@+id/empty_mascot"
                app:layout_constraintRight_toRightOf="@+id/empty_mascot"
                app:layout_constraintTop_toBottomOf="@+id/empty_mascot"
                app:tint="?attr/colorPrimary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/empty_meds_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4sp"
            android:text="@string/empty_meds_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_empty_action"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:minWidth="240dp"
            android:paddingVertical="16dp"
            android:text="@string/empty_meds_action"
            android:textSize="18sp"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconSize="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
