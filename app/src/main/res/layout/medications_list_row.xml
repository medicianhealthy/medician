<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    app:cardCornerRadius="10dp"
    android:elevation="10dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/medication_list_row_parent"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:elevation="5dp"
        android:padding="8dp">

        <TextView
            android:id="@+id/med_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingEnd="10dp"
            android:text="Symbalta Symbalta Symbalta Symbalta SymbaltaS ymbalta Symbal"
            android:textSize="@dimen/medication_name_txt_size"
            app:layout_constraintLeft_toLeftOf="@id/medication_list_row_parent"
            app:layout_constraintTop_toTopOf="@id/medication_list_row_parent"
            app:layout_constraintWidth_max="300dp" />

        <TextView
            android:id="@+id/med_strength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60mg"
            android:textColor="@color/cardview_dark_background"
            android:textSize="@dimen/medication_strength_txt_size"
            app:layout_constraintBottom_toBottomOf="@id/med_name"
            app:layout_constraintLeft_toRightOf="@id/med_name"
            app:layout_constraintTop_toTopOf="@id/med_name" />

        <TextView
            android:id="@+id/take"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="@string/take"
            android:textSize="@dimen/take_text_size"
            app:layout_constraintLeft_toLeftOf="@id/med_name"
            app:layout_constraintTop_toBottomOf="@id/med_name" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="3"
            android:textSize="@dimen/take_text_quantity"
            app:layout_constraintBottom_toBottomOf="@id/take"
            app:layout_constraintLeft_toRightOf="@id/take"
            app:layout_constraintTop_toBottomOf="@id/med_name"
            app:layout_constraintTop_toTopOf="@id/take" />

        <TextView
            android:id="@+id/form"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="Pills"
            android:textSize="@dimen/take_text_quantity"
            app:layout_constraintBottom_toBottomOf="@id/quantity"
            app:layout_constraintLeft_toRightOf="@id/quantity"
            app:layout_constraintTop_toBottomOf="@id/quantity"
            app:layout_constraintTop_toTopOf="@id/quantity" />

        <TextView
            android:id="@+id/at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="At"
            android:textSize="@dimen/take_text_quantity"
            app:layout_constraintBottom_toBottomOf="@id/form"
            app:layout_constraintLeft_toRightOf="@id/form"
            app:layout_constraintTop_toBottomOf="@id/form"
            app:layout_constraintTop_toTopOf="@id/form" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="10dp"
            android:text="13:30"
            android:textSize="@dimen/take_text_quantity"
            app:layout_constraintBottom_toBottomOf="@id/at"
            app:layout_constraintLeft_toRightOf="@id/at"
            app:layout_constraintTop_toBottomOf="@id/at"
            app:layout_constraintTop_toTopOf="@id/at" />

        <TextView
            android:id="@+id/directions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="After a meal with a glass of water"
            android:textSize="@dimen/take_text_quantity"
            app:layout_constraintLeft_toLeftOf="@id/medication_list_row_parent"
            app:layout_constraintTop_toBottomOf="@id/take" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/skip_btn"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skip"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="@id/medication_list_row_parent"
            app:layout_constraintTop_toBottomOf="@id/directions" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/take_btn"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Take"
            android:textSize="15sp"
            app:layout_constraintRight_toRightOf="@id/medication_list_row_parent"
            app:layout_constraintTop_toBottomOf="@id/directions" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/rescheduele"
            style="@style/Widget.AppCompat.Button.Borderless.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reschedule"
            android:textSize="15sp"
            app:layout_constraintRight_toLeftOf="@id/take_btn"
            app:layout_constraintTop_toBottomOf="@id/directions" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>