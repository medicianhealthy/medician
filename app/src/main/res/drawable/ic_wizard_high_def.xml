<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="300"
    android:viewportHeight="300">

    <!-- Ambient Magical Glow -->
    <path
        android:pathData="M150,150m-140,0a140,140 0,1 1,280 0a140,140 0,1 1,-280 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="150"
                android:centerY="150"
                android:gradientRadius="140"
                android:type="radial">
                <item android:color="#1A009688" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Circular Backdrop (Clean Teal Gradient) -->
    <path
        android:pathData="M150,150m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="150"
                android:centerY="150"
                android:gradientRadius="100"
                android:type="radial">
                <item android:color="#FF4DB6AC" android:offset="0.0" />
                <item android:color="#FF00796B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Owl Body (Soft Yellow) -->
    <path
        android:fillColor="#FFF59D"
        android:pathData="M150,80c-45,0 -70,30 -70,70c0,50 30,80 70,80s70,-30 70,-80c0,-40 -25,-70 -70,-70z" />

    <!-- Owl Face (White Area) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M150,105c-35,0 -55,20 -55,45c0,20 25,35 55,35s55,-15 55,-35c0,-25 -20,-45 -55,-45z" />

    <!-- Eyes (Friendly Large Circles) -->
    <path
        android:fillColor="#263238"
        android:pathData="M120,140m-14,0a14,14 0,1 1,28 0a14,14 0,1 1,-28 0" />
    <path
        android:fillColor="#263238"
        android:pathData="M180,140m-14,0a14,14 0,1 1,28 0a14,14 0,1 1,-28 0" />

    <!-- Eye Highlights -->
    <path android:fillColor="#FFFFFF" android:pathData="M124,134m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
    <path android:fillColor="#FFFFFF" android:pathData="M184,134m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- The Smile (Friendly curve) -->
    <path
        android:strokeColor="#263238"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M135,175c10,8 20,8 30,0" />

    <!-- Beak (Small and Cute) -->
    <path
        android:fillColor="#FFB300"
        android:pathData="M150,155l-7,10l14,0z" />

    <!-- Doctor's Head Mirror -->
    <path
        android:fillColor="#B0BEC5"
        android:pathData="M150,95m-15,0a15,15 0,1 1,30 0a15,15 0,1 1,-30 0" />
    <path
        android:fillColor="#E1F5FE"
        android:pathData="M150,95m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />

    <!-- Stethoscope (Draped around neck) -->
    <path
        android:strokeColor="#546E7A"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M100,185c0,20 100,20 100,0" />
    <path
        android:fillColor="#546E7A"
        android:pathData="M150,210m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />

    <!-- Medical Heart (The "Medician" Brand Mark) -->
    <path
        android:fillColor="#E91E63"
        android:pathData="M205,190c0,-6 -10,-6 -10,0c0,6 10,12 10,12s10,-6 10,-12c0,-6 -10,-6 -10,0" />
    <!-- White cross inside heart -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:pathData="M200,190l10,0M205,185l0,10" />

    <!-- Magic Sparkles -->
    <path android:fillColor="#FFFFFF" android:pathData="M245,120l2,6l6,2l-6,2l-2,6l-2,-6l-6,-2l6,-2z" />
    <path android:fillColor="#FFFFFF" android:pathData="M55,130l1,4l4,1l-4,1l-1,4l-1,-4l-4,-1l4,-1z" />

</vector>
